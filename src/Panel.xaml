<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        BorderBrush="#50483F" BorderThickness="1" CornerRadius="22"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        TextElement.FontFamily="Microsoft YaHei UI, Segoe UI" TextElement.FontSize="13"
        TextElement.Foreground="#F2E9DB" KeyboardNavigation.TabNavigation="Cycle">
  <Border.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1">
      <GradientStop Color="#F62B2825" Offset="0" />
      <GradientStop Color="#FA211F1D" Offset="0.42" />
      <GradientStop Color="#F71D1C1B" Offset="1" />
    </LinearGradientBrush>
  </Border.Background>
  <Border.Resources>
    <SolidColorBrush x:Key="MainText" Color="#F2E9DB" />
    <SolidColorBrush x:Key="SoftText" Color="#B6A99A" />
    <SolidColorBrush x:Key="QuietText" Color="#A79A8A" />
    <SolidColorBrush x:Key="Amber" Color="#DDA45D" />
    <SolidColorBrush x:Key="ThoughtInk" Color="#ADB9C0" />
    <Geometry x:Key="ThoughtNote">M 9.5,2 L 3,2 L 3,15 L 13,15 L 13,5.5 Z M 9.5,2 L 9.5,5.5 L 13,5.5 M 5.4,8.6 L 10.6,8.6 M 5.4,11.4 L 9.2,11.4</Geometry>

    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource SoftText}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="#3A3129" />
                <Setter Property="Foreground" Value="{StaticResource MainText}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="#493A2C" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource Amber}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
    </Style>

    <Style x:Key="PinStyle" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
      <Setter Property="ToolTip" Value="固定面板" />
      <Setter Property="AutomationProperties.Name" Value="固定面板" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource Amber}" />
          <Setter Property="Background" Value="#392E24" />
          <Setter Property="BorderBrush" Value="#624B36" />
          <Setter Property="ToolTip" Value="取消固定" />
          <Setter Property="AutomationProperties.Name" Value="取消固定" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Width" Value="29" />
      <Setter Property="Height" Value="29" />
      <Setter Property="Background" Value="#34302C" />
      <Setter Property="BorderBrush" Value="#454039" />
      <Setter Property="Foreground" Value="#E0B984" />
    </Style>

    <Style x:Key="ZoneTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource MainText}" />
    </Style>

    <Style x:Key="ZoneCount" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinWidth" Value="10" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource SoftText}" />
    </Style>

    <Style x:Key="TaskEntry" TargetType="TextBox">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Margin" Value="0,0,0,7" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Foreground" Value="{StaticResource MainText}" />
      <Setter Property="Background" Value="#302822" />
      <Setter Property="BorderBrush" Value="#8F6740" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{StaticResource Amber}" />
      <Setter Property="SelectionBrush" Value="#815C37" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                            VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="QuickEntry" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource MainText}" />
      <Setter Property="CaretBrush" Value="{StaticResource ThoughtInk}" />
      <Setter Property="SelectionBrush" Value="#657681" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="AcceptsReturn" Value="False" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid Background="{TemplateBinding Background}">
              <TextBlock x:Name="Hint" Text="记下分心念头…" FontSize="12" Foreground="#B0A89D"
                         IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed" />
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ThoughtFeedback" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#DDB889" />
      <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TrackPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent" Margin="0,2,2,3">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource TrackPage}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource TrackPage}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb MinHeight="18">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                          <Border x:Name="ScrollThumb" Width="4" HorizontalAlignment="Right" Margin="0,0,2,0"
                                  CornerRadius="2" Background="#665649" />
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ScrollThumb" Property="Background" Value="#9B8065" />
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ScrollThumb" Property="Background" Value="#B48B62" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Border.Resources>

  <Grid Margin="17,9,17,5">
    <Grid.RowDefinitions>
      <RowDefinition Height="62" />
      <RowDefinition Height="*" />
      <RowDefinition Height="49" />
    </Grid.RowDefinitions>

    <Grid Margin="4,0,1,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="记下" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource MainText}"
                 VerticalAlignment="Center" Margin="0,0,0,2" />
      <Button x:Name="PinButton" Grid.Column="1" Style="{StaticResource PinStyle}" Margin="0,0,5,0">
        <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.35"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              Data="M 8,1 L 13,6 L 11,6.5 L 9.5,8 L 9,11.5 L 4.5,7 L 8,6.5 L 9.5,5 L 8,1 Z M 6.7,9.3 L 2,14" />
      </Button>
      <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource HeaderButton}"
              AutomationProperties.Name="收起" ToolTip="收起">
        <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.35"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              Data="M 2,7 L 10,7 M 6.5,3.5 L 10,7 L 6.5,10.5 M 13,2 L 13,12" />
      </Button>
    </Grid>

    <Grid x:Name="TaskSections" Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="1.05*" />
        <RowDefinition Height="10" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border x:Name="UrgentZone" AllowDrop="True" AutomationProperties.Name="紧急任务区" Background="#292622" BorderBrush="#494037"
              BorderThickness="1" CornerRadius="13">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="43" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="12,0,9,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="3" Height="13" CornerRadius="1.5" Background="{StaticResource Amber}"
                    VerticalAlignment="Center" Margin="0,0,9,0" />
            <TextBlock Grid.Column="1" Text="紧急" Style="{StaticResource ZoneTitle}" />
            <Border Grid.Column="2" Background="#382E25" BorderBrush="#4B3C2E" BorderThickness="1"
                    Padding="4,0" MinHeight="19" CornerRadius="7" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Margin="7,0,0,0">
              <TextBlock x:Name="UrgentCount" Text="0" Style="{StaticResource ZoneCount}" />
            </Border>
            <Button x:Name="UrgentAdd" Grid.Column="3" Style="{StaticResource AddButton}"
                    AutomationProperties.Name="添加紧急任务" ToolTip="添加紧急任务">
              <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.35"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 1,6 L 11,6 M 6,1 L 6,11" />
            </Button>
          </Grid>
          <Grid Grid.Row="1" ClipToBounds="True">
            <Grid Margin="0,0,0,3">
              <StackPanel x:Name="UrgentEmpty" IsHitTestVisible="False" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Margin="0,0,0,7">
                <Border Width="32" Height="30" CornerRadius="9" BorderBrush="#514437" BorderThickness="1"
                        Background="#302820" HorizontalAlignment="Center" Margin="0,0,0,8">
                  <Path Width="13" Height="13" Stretch="Uniform" Stroke="#BD956C" StrokeThickness="1.2"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="M 6.5,1 L 12,6.5 L 6.5,12 L 1,6.5 Z M 6.5,4 L 6.5,7 M 6.5,9 L 6.5,9.15" />
                </Border>
                <TextBlock Text="暂无紧急任务" Foreground="{StaticResource QuietText}" FontSize="12" />
              </StackPanel>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" PanningMode="VerticalOnly" CanContentScroll="False">
              <StackPanel Margin="11,1,11,8">
                <TextBox x:Name="UrgentEntry" Style="{StaticResource TaskEntry}" AutomationProperties.Name="紧急任务标题" />
                <StackPanel x:Name="UrgentItems" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>

      <Border x:Name="LaterZone" Grid.Row="2" AllowDrop="True" AutomationProperties.Name="不紧急任务区" Background="#252422" BorderBrush="#3D3935"
              BorderThickness="1" CornerRadius="13">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="43" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="12,0,9,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="3" Height="13" CornerRadius="1.5" Background="#958675"
                    VerticalAlignment="Center" Margin="0,0,9,0" />
            <TextBlock Grid.Column="1" Text="不紧急" Style="{StaticResource ZoneTitle}" />
            <Border Grid.Column="2" Background="#302A24" BorderBrush="#443A31" BorderThickness="1"
                    Padding="4,0" MinHeight="19" CornerRadius="7" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Margin="7,0,0,0">
              <TextBlock x:Name="LaterCount" Text="0" Style="{StaticResource ZoneCount}" />
            </Border>
            <Button x:Name="LaterAdd" Grid.Column="3" Style="{StaticResource AddButton}"
                    AutomationProperties.Name="添加不紧急任务" ToolTip="添加不紧急任务">
              <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.35"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 1,6 L 11,6 M 6,1 L 6,11" />
            </Button>
          </Grid>
          <Grid Grid.Row="1" ClipToBounds="True">
            <Grid Margin="0,0,0,3">
              <StackPanel x:Name="LaterEmpty" IsHitTestVisible="False" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Margin="0,0,0,7">
                <Border Width="32" Height="30" CornerRadius="9" BorderBrush="#474039" BorderThickness="1"
                        Background="#2B2722" HorizontalAlignment="Center" Margin="0,0,0,8">
                  <Path Width="13" Height="13" Stretch="Uniform" Stroke="#A89A89" StrokeThickness="1.2"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="M 6.5,1 A 5.5,5.5 0 1 1 6.5,12 A 5.5,5.5 0 1 1 6.5,1 Z M 6.5,3.5 L 6.5,6.7 L 8.7,8" />
                </Border>
                <TextBlock Text="暂无不紧急任务" Foreground="{StaticResource QuietText}" FontSize="12" />
              </StackPanel>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" PanningMode="VerticalOnly" CanContentScroll="False">
              <StackPanel Margin="11,1,11,8">
                <TextBox x:Name="LaterEntry" Style="{StaticResource TaskEntry}" AutomationProperties.Name="不紧急任务标题" />
                <StackPanel x:Name="LaterItems" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="ThoughtReview" Grid.Row="1" Visibility="Collapsed">
      <Border Background="#282622" BorderBrush="#494037" BorderThickness="1" CornerRadius="13">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="51" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="13,0,9,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Path Width="14" Height="15" Stretch="Uniform" Stroke="{StaticResource ThoughtInk}" StrokeThickness="1.25"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  VerticalAlignment="Center" Margin="0,0,8,0"
                  Data="{StaticResource ThoughtNote}" />
            <TextBlock Grid.Column="1" Text="分心记录" Style="{StaticResource ZoneTitle}" FontSize="16" />
            <Border Grid.Column="2" Background="#323331" BorderBrush="#454744" BorderThickness="1"
                    Padding="6,2" CornerRadius="7" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="待处理" FontSize="11" Foreground="#B6BCBC" VerticalAlignment="Center" />
                <TextBlock x:Name="ThoughtPendingCount" Text="0" Style="{StaticResource ZoneCount}"
                           Foreground="#CFD5D3" Margin="3,0,0,0" />
              </StackPanel>
            </Border>
            <Button x:Name="ThoughtBack" Grid.Column="3" Style="{StaticResource ActionButton}"
                    Height="29" MinWidth="57" Margin="5,0,0,0" Padding="5,0"
                    AutomationProperties.Name="返回任务清单" ToolTip="返回任务清单">
              <StackPanel Orientation="Horizontal">
                <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.3"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      VerticalAlignment="Center" Margin="0,0,5,0" Data="M 11,6 L 1,6 M 5,2 L 1,6 L 5,10" />
                <TextBlock Text="清单" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
          <TextBlock x:Name="ThoughtReviewStatus" Grid.Row="1" Style="{StaticResource ThoughtFeedback}"
                     TextWrapping="Wrap" Margin="12,0,12,7" />
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Focusable="False" PanningMode="VerticalOnly" CanContentScroll="False">
            <StackPanel Margin="11,1,11,10">
              <StackPanel x:Name="ThoughtItems" />
              <Grid x:Name="ThoughtEmpty" MinHeight="122" IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Border Width="35" Height="32" CornerRadius="9" BorderBrush="#494A45" BorderThickness="1"
                          Background="#30302D" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource ThoughtInk}" StrokeThickness="1.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="{StaticResource ThoughtNote}" />
                  </Border>
                  <TextBlock Text="暂无待处理记录" Foreground="{StaticResource QuietText}" FontSize="12" />
                </StackPanel>
              </Grid>
              <Button x:Name="ThoughtHistoryToggle" Style="{StaticResource ActionButton}"
                      HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" MinHeight="32"
                      Margin="0,3,0,4" Padding="8,0" Foreground="#B6BCBC"
                      Background="#2D2C29" BorderBrush="#3F403B">
                <TextBlock x:Name="ThoughtHistoryLabel" Text="已处理 0 ▸" FontSize="12" TextWrapping="NoWrap" />
              </Button>
              <StackPanel x:Name="ThoughtHistoryItems" Visibility="Collapsed" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="Footer" Grid.Row="2" Margin="0,6,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border x:Name="RestFooter" BorderThickness="1" CornerRadius="10" Padding="0,0,3,0">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="#282622" />
            <Setter Property="BorderBrush" Value="#49443C" />
            <Style.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="#2C2A26" />
                <Setter Property="BorderBrush" Value="#77766A" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Path Width="14" Height="15" Stretch="Uniform" Stroke="{StaticResource ThoughtInk}" StrokeThickness="1.25"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                Data="{StaticResource ThoughtNote}" />
          <Grid Grid.Column="1" Margin="0,0,4,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="ThoughtEntry" Style="{StaticResource QuickEntry}" Margin="0,2"
                     AutomationProperties.Name="记下分心念头" />
            <TextBlock x:Name="ThoughtStatus" Grid.Row="1" Style="{StaticResource ThoughtFeedback}"
                       TextTrimming="CharacterEllipsis" FontSize="10" Margin="0,0,0,3" />
          </Grid>
          <Button x:Name="ThoughtSubmit" Grid.Column="2" Width="30" Height="29" Margin="0,0,3,0"
                  Foreground="{StaticResource ThoughtInk}" AutomationProperties.Name="保存速记" ToolTip="保存速记（Enter）">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=ThoughtEntry}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.35"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Data="M 13,2 L 13,8 L 2,8 M 5.5,4.5 L 2,8 L 5.5,11.5" />
          </Button>
          <Button x:Name="ThoughtToggle" Grid.Column="3" Style="{StaticResource ActionButton}" Height="31"
                  MinWidth="69" Padding="7,0" Background="#343431" BorderBrush="#4D4B44" Foreground="#D3D2CA"
                  AutomationProperties.Name="{Binding Text, ElementName=ThoughtToggleLabel}">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ThoughtToggleLabel" Text="记录" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border Background="#42433D" CornerRadius="5" MinWidth="17" Height="17" Padding="3,0" Margin="5,0,0,0">
                <TextBlock x:Name="ThoughtCount" Text="0" Style="{StaticResource ZoneCount}" MinWidth="8" Foreground="#D4D7D3" />
              </Border>
            </StackPanel>
          </Button>
        </Grid>
      </Border>
      <Border x:Name="TrashTarget" Grid.ColumnSpan="2" Visibility="Collapsed" AllowDrop="True" Background="#3A3025"
              BorderBrush="#8F6C47" BorderThickness="1" CornerRadius="10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
          <Grid x:Name="BinArt" Width="42" Height="40" Margin="0,0,8,0" />
          <TextBlock x:Name="TrashLabel" Text="拖到这里完成" Width="76" FontSize="12" FontWeight="SemiBold" Foreground="#F0D0AA"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <Border x:Name="UndoBar" Grid.Column="1" Width="80" Margin="4,0,0,0" Visibility="Collapsed"
              Background="#322B24" BorderBrush="#564432" BorderThickness="1" CornerRadius="10" Padding="2,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="UndoLabel" Text="已完成" FontSize="10.5" Foreground="#E9D4B8"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button x:Name="UndoButton" Grid.Column="1" Content="撤销" Style="{StaticResource ActionButton}"
                  Background="#3D3226" BorderBrush="#5B4833" Foreground="{StaticResource Amber}"
                  FontSize="12" FontWeight="SemiBold" Width="38" Height="33" VerticalAlignment="Center"
                  AutomationProperties.Name="撤销完成任务" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Border>
